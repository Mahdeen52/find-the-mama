# Pooled Neon Postgres connection used by the application
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DATABASE?sslmode=require"

# Direct Neon connection used by Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Replace with a long random secret in production
JWT_SECRET="replace-with-a-long-random-secret"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: enables persistent image uploads. Without these, the demo uses a small data-URL fallback.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
